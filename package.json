{
  "name": "dsh-chat-search",
  "version": "1.2.1",
  "description": "DSH 全局搜索与会话搜索插件：在所有会话或当前会话中搜索聊天记录，同时检索正文段落与文件名；支持按日期范围与每个会话的最近轮次过滤，结果按「会话 → 问题 → 段落」展开，跳转后自动定位并高亮命中词。Global and in-session search with paragraph and file-name matching.",
  "type": "module",
  "license": "MIT",
  "author": "Yu Hai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timefarer/dsh-chat-search.git"
  },
  "homepage": "https://github.com/timefarer/dsh-chat-search#readme",
  "bugs": {
    "url": "https://github.com/timefarer/dsh-chat-search/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "search",
    "global-search",
    "conversation",
    "chat-history",
    "full-text",
    "paragraph",
    "filename",
    "filter",
    "filters"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/host.mjs && node test/client.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "meta": {
    "title": "全局搜索与会话搜索",
    "description": "在全部或当前会话中搜索聊天记录，同时检索段落与文件名；按日期范围、每会话轮次过滤；结果三层展开，跳转定位并高亮命中词。"
  }
}
