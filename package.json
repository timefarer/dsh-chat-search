{
  "name": "dsh-chat-search",
  "version": "1.1.1",
  "description": "DeepSeek Harness（dsh）对话检索插件：按段落与文件名检索当前或全部会话，支持日期/轮次筛选、三层结果、跳转与高亮。",
  "type": "module",
  "license": "MIT",
  "author": "Yu Hai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timefarer/dsh-chat-search.git"
  },
  "homepage": "https://github.com/timefarer/dsh-chat-search#readme",
  "bugs": {
    "url": "https://github.com/timefarer/dsh-chat-search/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "search",
    "conversation",
    "full-text",
    "filters"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/host.mjs && node test/client.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "meta": {
    "title": "对话段落搜索",
    "description": "按段落与文件名检索对话，支持日期/轮次范围、三层结果与跳转高亮。Paragraph- and file-name conversation search with a date/turn window."
  }
}
